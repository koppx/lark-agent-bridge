[Unit]
Description=Lark agent bridge (Feishu <-> remote agent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 按 deploy/server.md 替换用户；两个服务使用同一位已配置 Claude 的用户
User=YOUR_SERVER_USER
WorkingDirectory=/opt/lark-agent-bridge
EnvironmentFile=/opt/lark-agent-bridge/.env
ExecStart=/opt/lark-agent-bridge/.venv/bin/python -m bridge.app --env /opt/lark-agent-bridge/.env
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
# 日志里会带 open_id，注意别把日志暴露给无关人员
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
