[Unit]
Description=Remote agent HTTP service (wraps claude -p)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 按 deploy/server.md 替换用户；命令、工作目录和 token 从 .env 读取
User=YOUR_SERVER_USER
WorkingDirectory=/opt/lark-agent-bridge
EnvironmentFile=/opt/lark-agent-bridge/.env
ExecStart=/opt/lark-agent-bridge/.venv/bin/python remote_agent_server.py \
    --host 127.0.0.1 \
    --port 8787 \
    --timeout 840
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
