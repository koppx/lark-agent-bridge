# ---------- 飞书自建应用（必填） ----------
# 开放平台 → 你的应用 → 凭证与基础信息
# wusi的飞书 CLI 的 App ID：cli_aa9c105a7678dbdb
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 可选：机器人自己的 open_id，留空则启动时自动获取
BOT_OPEN_ID=

# ---------- 谁能用（强烈建议填写） ----------
# 逗号分隔的 open_id；留空 = 拒绝所有人（首次启动故意这样，日志里会打印你的 open_id，复制进来再重启）
ALLOW_OPEN_IDS=

# 可选的群/会话白名单，逗号分隔 chat_id；留空 = 不限制会话
ALLOW_CHAT_IDS=

# ---------- agent 怎么连 ----------
# 跨网络推荐：bridge 与 agent 服务都放在服务器，本机只使用飞书
# http | ssh | local
AGENT_TRANSPORT=http

# http 模式：远端 agent 的 HTTP 接口（见 remote_agent_server.py）
AGENT_URL=http://127.0.0.1:8787/task
AGENT_TOKEN=change-me-please

# ---------- HTTP agent 服务 ----------
# 使用现有 Claude Code 登录/模型配置；正式部署填命令与工作目录的绝对路径
# 含空格的值保留引号，兼容教程中的 shell 加载和 systemd EnvironmentFile
CLAUDE_COMMAND="claude -p --output-format json"
CLAUDE_WORKDIR=/srv/repo

# ssh 模式：远端执行命令（prompt 从 stdin 传入）
SSH_TARGET=root@1.2.3.4
SSH_COMMAND="claude -p --output-format text"

# local 模式：本机执行的命令（prompt 从 stdin 传入）
LOCAL_COMMAND="claude -p --output-format text"

# 单次任务超时（秒）
AGENT_TIMEOUT=900

# 不同会话的任务线程数；不是同一个会话的并发数
WORKERS=4

# ---------- 输出 ----------
# 每条消息最大字符数（飞书文本消息有上限，超了要分片）
MAX_CHUNK_CHARS=3500
# 最多分几条，超出就截断并提示
MAX_CHUNKS=12

# 状态目录（会话映射、日志）
STATE_DIR=./state

LOG_LEVEL=INFO
